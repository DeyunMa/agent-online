# Copy this file to .dev.vars. Never commit .dev.vars.

# Authentication
BETTER_AUTH_SECRET=replace-with-a-unique-high-entropy-secret
BETTER_AUTH_URL=http://localhost:5173

# Deployment guardrails. Omitted locally means open access and enabled Runs.
# ACCESS_MODE=allowlist
# ACCESS_ALLOWED_EMAILS=owner@example.com
# RUNS_ENABLED=false

# Platform model
GEMINI_API_KEY=

# Add only when the real E2B runtime adapter is enabled.
# E2B_API_KEY=

# Non-secret exact E2B template build reference, such as agent-online-pi-runtime:<build-id>.
# E2B_TEMPLATE_ID=

# Runtime configuration. Fake is the default when omitted.
# RUNTIME_PROVIDER=e2b
# DEFAULT_MODEL_ID=gemini-2.5-flash
# RUNTIME_IDLE_TTL_SECONDS=600
# MAX_RUN_WALL_SECONDS=1800

# Public HTTPS origin used only when a local E2B sandbox cannot reach localhost.
# MODEL_GATEWAY_BASE_URL=

# Add only when the internal usage view is implemented.
# ADMIN_EMAILS=
