# Browser error monitoring. The DSN is public configuration, not a model/provider secret.
# Preview builds load the same names from an ignored .env.preview.local file.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Source-map upload credentials belong in the ignored .env.sentry-build-plugin file:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=dylandeyunma
# SENTRY_PROJECT=agent-online
