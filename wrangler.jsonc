{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-online",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    { "name": "MCP_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "MCP_REGISTRATION_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-online-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "workflows": [
    {
      "binding": "AGENT_RUN_WORKFLOW",
      "name": "agent-online-run",
      "class_name": "AgentRunWorkflow"
    }
  ],
  "env": {
    "preview": {
      "account_id": "66a06222aa0acd9ea509abad73fa02fb",
      "workers_dev": true,
      "ratelimits": [
        {
          "name": "MCP_RATE_LIMIT",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "MCP_REGISTRATION_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"]
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": false,
          "head_sampling_rate": 0,
          "persist": false
        }
      },
      "vars": {
        "ACCESS_MODE": "allowlist",
        "BETTER_AUTH_URL": "https://agent-online-preview.mdy1145141.workers.dev",
        "DEFAULT_MODEL_ID": "gemini-3.6-flash",
        "MAX_RUN_WALL_SECONDS": "1800",
        "RUNTIME_IDLE_TTL_SECONDS": "600",
        "RUNTIME_PROVIDER": "e2b",
        "RUNS_ENABLED": "true",
        "SENTRY_ENVIRONMENT": "preview"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-online-preview-db",
          "database_id": "f5b3193a-298b-4a61-a07b-24f5fc26c28e",
          "migrations_dir": "./migrations"
        }
      ],
      "workflows": [
        {
          "binding": "AGENT_RUN_WORKFLOW",
          "name": "agent-online-preview-run",
          "class_name": "AgentRunWorkflow"
        }
      ]
    }
  }
}
