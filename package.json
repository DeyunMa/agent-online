{
  "name": "agent-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "clean:build-output": "node scripts/clean-build-output.mjs",
    "validate:build-artifacts": "node scripts/validate-build-artifacts.mjs",
    "validate:source-secrets": "node scripts/validate-source-secrets.mjs",
    "build": "pnpm clean:build-output && vite build && pnpm validate:build-artifacts",
    "build:preview": "pnpm clean:build-output && CLOUDFLARE_ENV=preview vite build --mode preview && pnpm validate:build-artifacts",
    "preview": "vite preview",
    "validate:production-config": "node scripts/validate-production-config.mjs",
    "deploy": "pnpm validate:production-config && pnpm build && wrangler deploy --var \"E2B_TEMPLATE_ID:$E2B_TEMPLATE_ID\"",
    "validate:preview-config": "node scripts/validate-preview-config.mjs",
    "validate:preview-account": "node scripts/validate-preview-account.mjs",
    "release:preview:preflight": "node scripts/validate-preview-release-state.mjs --remote",
    "release:preview:preflight:local": "node scripts/validate-preview-release-state.mjs --local",
    "deploy:preview": "pnpm validate:preview-account && pnpm validate:preview-config && SENTRY_UPLOAD_SOURCEMAPS=true pnpm build:preview && wrangler deploy --env preview --var \"E2B_TEMPLATE_ID:$E2B_TEMPLATE_ID\"",
    "deploy:preview:dry-run": "pnpm validate:preview-config && pnpm build:preview && wrangler deploy --env preview --dry-run --var \"E2B_TEMPLATE_ID:$E2B_TEMPLATE_ID\"",
    "check": "pnpm check:static && pnpm test && pnpm build && pnpm test:browser",
    "check:static": "pnpm check:boundaries && pnpm validate:source-secrets && pnpm lint && pnpm format:check && pnpm typecheck",
    "check:boundaries": "node --test scripts/check-import-boundaries.test.mjs && node scripts/check-import-boundaries.mjs",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:d1",
    "test:browser": "playwright test",
    "test:d1": "vitest run --config vitest.cloudflare.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "build:e2b-pi-template": "node templates/e2b/build-pi-runtime-template.mjs",
    "test:e2e:e2b-pi": "RUN_E2E=1 vitest run --config vitest.config.ts src/integration/e2b-pi-gemini.e2e.test.ts",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.76",
    "@base-ui/react": "1.7.0",
    "@better-auth/cimd": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "5.9.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sentry/cloudflare": "10.69.0",
    "@sentry/hono": "10.69.0",
    "@sentry/react": "10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "7.0.107",
    "better-auth": "^1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "e2b": "2.36.0",
    "eventsource-parser": "4.1.0",
    "hono": "^4.12.32",
    "jose": "6.2.12",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.87.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@biomejs/biome": "2.5.5",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@playwright/test": "1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
